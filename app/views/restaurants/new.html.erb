<div class="container mt-4">
  <div class="card p-4">
    <h1>Add a restaurant</h1>
    <%= simple_form_for @restaurant do |f| %>
      <%= f.input :name %>
      <%= f.input :address %>
      <%= f.input :phone_number %>
      <%= f.input :category, collection: Restaurant::CATEGORIES %>
      <%= f.submit "Create restaurant", class: "btn btn-success" %>
    <% end %>
    <%= link_to "Back to restaurants", restaurants_path, class: "text-muted mt-3 d-inline-block" %>
  </div>
</div>
