<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Restaurants</h1>
    <%= link_to "Add a restaurant", new_restaurant_path, class: "btn btn-success" %>
  </div>

  <% @restaurants.each do |restaurant| %>
    <div class="card mb-3 p-3 d-flex flex-row align-items-center justify-content-between">
      <div>
        <h3><%= restaurant.name %></h3>
        <p class="text-muted mb-1"><%= restaurant.category %> · <%= restaurant.address %></p>
        <%= link_to "See details", restaurant_path(restaurant), class: "btn btn-outline-primary btn-sm", style: "width: 200px;" %>
      </div>
      <img src="<%= restaurant.flag_image %>" alt="<%= restaurant.category %> flag" style="width: 60px; height: auto; border-radius: 4px;">
    </div>
  <% end %>
</div>
