<div class="container mt-4">
  <div class="card p-4">
    <h1>Add a review for <%= @restaurant.name %></h1>
    <%= simple_form_for [@restaurant, @review] do |f| %>
      <%= f.input :content %>
      <%= f.input :rating %>
      <%= f.submit "Post review", class: "btn btn-primary" %>
    <% end %>
    <%= link_to "Back to restaurant", restaurant_path(@restaurant), class: "text-muted mt-3 d-inline-block" %>
  </div>
</div>
